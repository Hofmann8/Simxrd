{
  "name": "simxrd",
  "version": "0.9.3-beta",
  "description": "X射线衍射模拟工具",
  "author": "Lin Kai <Alexphant@mail.dlut.edu.cn>",
  "license": "MIT",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@arco-design/web-react": "^2.61.2",
    "@fontsource/roboto": "^5.1.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/user-event": "^13.5.0",
    "3dmol": "^2.4.0",
    "axios": "^1.6.8",
    "bootstrap": "^5.3.3",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^6.5.1",
    "highlight.js": "^11.9.0",
    "mathjs": "^14.3.0",
    "punycode": "^2.3.1",
    "react": "^17.0.2",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^17.0.2",
    "react-draggable": "^4.4.6",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.22.3",
    "react-scripts": "^5.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-transition-group": "^4.4.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "coverage": "npm run test -- --watchAll=false --coverage",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron . dev\"",
    "electron-prod": "npm run build && electron .",
    "electron": "npm run electron-dev",
    "kill-port": "npx kill-port 3000",
    "electron-dev-clean": "npm run kill-port && npm run electron-dev",
    "build:wasm": "cd wasm/xrd_core && compile.bat",
    "build:utf8": "chcp 65001 && react-scripts build",
    "electron-dev:utf8": "chcp 65001 && concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron . dev\"",
    "electron-prod:utf8": "chcp 65001 && npm run build && electron . prod",
    "electron-build": "chcp 65001 && electron-builder",
    "electron-build:win": "chcp 65001 && electron-builder --win",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/react": "^12.1.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.1",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^3.2.0",
    "kill-port": "^2.0.1",
    "react-app-rewired": "^2.2.1",
    "wait-on": "^8.0.2"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-syntax-highlighter)/)"
    ],
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "<rootDir>/__mocks__/styleMock.js",
      "\\.(gif|ttf|eot|svg)$": "<rootDir>/__mocks__/fileMock.js"
    }
  },
  "main": "src/main.js",
  "build": {
    "appId": "com.dlut.simxrd",
    "productName": "SimXRD",
    "copyright": "Copyright © 2024 Lin Kai, DUT",
    "files": [
      "build/**/*",
      "src/main.js",
      "src/preload.js",
      "src/preload-simple.js",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src",
        "to": "app/src",
        "filter": [
          "preload.js",
          "preload-simple.js"
        ]
      },
      {
        "from": "build",
        "to": "app/build"
      }
    ],
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/simxrd.ico"
    },
    "extraMetadata": {
      "main": "src/main.js"
    },
    "asar": {
      "smartUnpack": false
    },
    "npmRebuild": false,
    "forceCodeSigning": false
  }
}